  <diagram id="rans-flow" name="rans-flow">
    <mxGraphModel dx="1280" dy="1170" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1170" background="#1f1e24" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="Кодирование" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=26;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;shape=text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="24" width="450" height="44" />
        </mxCell>
        <mxCell id="n2" value="Построить модель&#10;Подсчитать и нормализовать частоты.&#10;Найти начала интервалов c(s).&#10;Начальное состояние x = L." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="100" width="460" height="160" />
        </mxCell>
        <mxCell id="n3" value="Взять символ с конца&#10;Обрабатывать вход справа налево.&#10;Для символа взять f(s) и c(s)." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="310" width="460" height="160" />
        </mxCell>
        <mxCell id="n4" value="Перенормировать состояние&#10;Пока x ≥ 524288 × f(s):&#10;выдать x mod 256; x = floor(x / 256)." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="520" width="460" height="160" />
        </mxCell>
        <mxCell id="n5" value="Закодировать символ&#10;x = floor(x / f(s)) × 4096&#10;+ (x mod f(s)) + c(s)&#10;Повторять шаги 2–4 для всего входа." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="730" width="460" height="160" />
        </mxCell>
        <mxCell id="n6" value="Записать выходной поток&#10;Длина, модель, конечное x (LE).&#10;Выданные байты — в обратном порядке." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="940" width="460" height="160" />
        </mxCell>
        <mxCell id="n7" value="Декодирование" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=26;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;shape=text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="24" width="450" height="44" />
        </mxCell>
        <mxCell id="n8" value="Прочитать модель и состояние&#10;Восстановить f(s), c(s) и состояние x.&#10;Построить таблицу на 4096 ячеек." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="100" width="460" height="160" />
        </mxCell>
        <mxCell id="n9" value="Найти и вывести символ&#10;q = x mod 4096.&#10;Выбрать s: c(s) ≤ q &lt; c(s) + f(s).&#10;Добавить s к результату." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="310" width="460" height="160" />
        </mxCell>
        <mxCell id="n10" value="Обратить переход&#10;x = f(s) × floor(x / 4096)&#10;+ q − c(s)" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="520" width="460" height="160" />
        </mxCell>
        <mxCell id="n11" value="Перенормировать состояние&#10;Пока x &lt; L: прочитать байт b;&#10;x = 256 × x + b.&#10;Повторять шаги 2–4 до длины N." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="730" width="460" height="160" />
        </mxCell>
        <mxCell id="n12" value="Завершить поток&#10;Проверить x = L.&#10;Все входные байты должны быть&#10;прочитаны." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="940" width="460" height="160" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n2" target="n3" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n3" target="n4" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n4" target="n5" parent="1">
