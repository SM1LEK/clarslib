  <diagram id="lz77-flow" name="lz77-flow">
    <mxGraphModel dx="1280" dy="1170" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1170" background="#1f1e24" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="Кодирование" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=26;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;shape=text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="24" width="450" height="44" />
        </mxCell>
        <mxCell id="n2" value="Начало блока&#10;Записать длину N как varint.&#10;position = 0; новый словарь." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="100" width="460" height="160" />
        </mxCell>
        <mxCell id="n3" value="Найти лучшую ссылку&#10;Окно 4096; длина до 255.&#10;Оставить один байт для литерала.&#10;При равной длине — ближайшая ссылка." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="310" width="460" height="160" />
        </mxCell>
        <mxCell id="n4" value="Записать тройку&#10;Длина, расстояние, следующий байт.&#10;При длине 0 расстояние не пишется." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="520" width="460" height="160" />
        </mxCell>
        <mxCell id="n5" value="Обновить словарь&#10;Добавить все пройденные позиции.&#10;position += длина + 1." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="730" width="460" height="160" />
        </mxCell>
        <mxCell id="n6" value="Перейти к следующей тройке&#10;Пока position &lt; N: повторить шаги 2–4.&#10;Иначе вернуть поток LZ77." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="940" width="460" height="160" />
        </mxCell>
        <mxCell id="n7" value="Декодирование" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=26;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;shape=text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="24" width="450" height="44" />
        </mxCell>
        <mxCell id="n8" value="Прочитать поток&#10;Прочитать N один раз; затем тройку.&#10;При ненулевой длине — расстояние.&#10;Прочитать следующий явный байт." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="100" width="460" height="160" />
        </mxCell>
        <mxCell id="n9" value="Проверить ссылку&#10;Расстояние не больше окна и выхода.&#10;Ненулевая ссылка: расстояние &gt; 0.&#10;Длина + литерал не выходят за N." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="310" width="460" height="160" />
        </mxCell>
        <mxCell id="n10" value="Восстановить совпадение&#10;Копировать по одному байту назад&#10;на заданное расстояние.&#10;Перекрытие ссылки допустимо." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="520" width="460" height="160" />
        </mxCell>
        <mxCell id="n11" value="Добавить литерал&#10;Записать следующий явный байт.&#10;До конца потока повторять шаги 1–4." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="730" width="460" height="160" />
        </mxCell>
        <mxCell id="n12" value="Завершить блок&#10;Проверить: восстановлено ровно N байт.&#10;Вернуть исходный блок." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="940" width="460" height="160" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n2" target="n3" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n3" target="n4" parent="1">
