  <diagram id="reed-solomon-flow" name="reed-solomon-flow">
    <mxGraphModel dx="1280" dy="1170" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1170" background="#1f1e24" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="Кодирование" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=26;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;shape=text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="24" width="450" height="44" />
        </mxCell>
        <mxCell id="n2" value="Разделить вход на слова&#10;До 223 байт данных в каждом слове.&#10;Последнее слово может быть короче." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="100" width="460" height="160" />
        </mxCell>
        <mxCell id="n3" value="Вычислить проверочную часть&#10;Операции в GF(256).&#10;32 байта чётности для каждого слова." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="310" width="460" height="160" />
        </mxCell>
        <mxCell id="n4" value="Записать кодовое слово&#10;Сначала данные, затем проверочные&#10;байты.&#10;Длина полного слова: 223 + 32 = 255." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="520" width="460" height="160" />
        </mxCell>
        <mxCell id="n5" value="Записать остальные слова&#10;Последнее слово: k + 32 байта.&#10;Заполнение до 223 байт не добавляется." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="730" width="460" height="160" />
        </mxCell>
        <mxCell id="n6" value="Разместить защиту в блоке&#10;Заголовок: отдельное слово 12 + 32.&#10;Сохранённые данные: отдельные слова." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="940" width="460" height="160" />
        </mxCell>
        <mxCell id="n7" value="Декодирование" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=26;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;shape=text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="24" width="450" height="44" />
        </mxCell>
        <mxCell id="n8" value="Прочитать кодовые слова&#10;Исходная длина задаёт ожидаемый&#10;размер.&#10;Полные слова по 255 байт; хвост короче." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="100" width="460" height="160" />
        </mxCell>
        <mxCell id="n9" value="Проверить и исправить слово&#10;Декодер reed-solomon восстанавливает&#10;до 16 неизвестных замен байтов.&#10;Замены могут затронуть и чётность." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="310" width="460" height="160" />
        </mxCell>
        <mxCell id="n10" value="Получить данные слова&#10;Отбросить 32 проверочных байта.&#10;Собрать данные восстановленных слов." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="520" width="460" height="160" />
        </mxCell>
        <mxCell id="n11" value="Восстановить исходный блок&#10;Для сжатого блока: rANS, затем LZ77.&#10;Декодировать включённые этапы." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="730" width="460" height="160" />
        </mxCell>
        <mxCell id="n12" value="Проверить результат&#10;Длина и CRC32 исходного блока.&#10;Для заголовка блока — собственная&#10;CRC32." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="940" width="460" height="160" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n2" target="n3" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n3" target="n4" parent="1">
