        <mxCell id="n4" value="Вход: S байт; 0 ≤ S ≤ 65536" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="200" width="460" height="75" />
        </mxCell>
        <mxCell id="n5" value="Создать Encoder(32)&#10;p = 0; R = пусто" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="335" width="460" height="85" />
        </mxCell>
        <mxCell id="n6" value="E(S) = S + 32 × ceil(S / 223)" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="480" width="460" height="65" />
        </mxCell>
        <mxCell id="n7" value="Остались данные?&#10;p &lt; S" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;shape=rhombus;perimeter=rhombusPerimeter;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="615" width="460" height="105" />
        </mxCell>
        <mxCell id="n8" value="k = min(223, S − p)&#10;m = данные[p…p + k]" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="790" width="460" height="85" />
        </mxCell>
        <mxCell id="n9" value="Вычислить 32 проверочных байта&#10;r(z) = (m(z) × z³²) mod g(z)&#10;Операции в GF(256)" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;shape=process;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="945" width="460" height="110" />
        </mxCell>
        <mxCell id="n10" value="Собрать кодовое слово:&#10;k исходных байтов&#10;+ 32 проверочных байта" style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1125" width="460" height="115" />
