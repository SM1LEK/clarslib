        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n6" target="n7" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n7" target="n8" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n8" target="n9" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n9" target="n10" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
