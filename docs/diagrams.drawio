  <diagram id="crc32-flow" name="crc32-flow">
    <mxGraphModel dx="1280" dy="1170" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1170" background="#1f1e24" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="Подготовить 256 ячеек&#10;Для каждого индекса i от 0 до 255&#10;начать с c = i." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="100" width="460" height="160" />
        </mxCell>
        <mxCell id="n2" value="Обработать младший бит&#10;Если c AND 1 = 0: c = c &gt;&gt; 1.&#10;Иначе: c = (c &gt;&gt; 1) XOR 0xEDB88320." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="310" width="460" height="160" />
        </mxCell>
        <mxCell id="n3" value="Выполнить восемь шагов&#10;Повторить обработку бита 8 раз&#10;для текущего индекса i." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="520" width="460" height="160" />
        </mxCell>
        <mxCell id="n4" value="Сохранить элемент&#10;TABLE[i] = c.&#10;Перейти к следующему индексу." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="730" width="460" height="160" />
        </mxCell>
        <mxCell id="n5" value="Получить готовую таблицу&#10;256 значений для отражённого полинома.&#10;Таблица общая для всех расчётов." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="940" width="460" height="160" />
        </mxCell>
        <mxCell id="n6" value="Начальный регистр&#10;crc = 0xFFFFFFFF." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="100" width="460" height="160" />
        </mxCell>
        <mxCell id="n7" value="Взять очередной байт b&#10;Обрабатывать байты в исходном порядке.&#10;index = (crc AND 255) XOR b." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="310" width="460" height="160" />
        </mxCell>
        <mxCell id="n8" value="Обновить регистр&#10;crc = (crc &gt;&gt; 8) XOR TABLE[index]." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="520" width="460" height="160" />
        </mxCell>
        <mxCell id="n9" value="Обработать весь вход&#10;Повторить шаги 2–3 для каждого байта.&#10;Таблица заменяет восемь битовых шагов." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="730" width="460" height="160" />
        </mxCell>
        <mxCell id="n10" value="Завершить расчёт&#10;CRC = NOT crc (инверсия 32 бит).&#10;Для пустого входа результат равен 0." style="whiteSpace=wrap;html=0;fillColor=#1f1e24;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="940" width="460" height="160" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n1" target="n2" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n2" target="n3" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#b3afb9;fontColor=#ececef;fontFamily=Arial;fontSize=20;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#1f1e24;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="n3" target="n4" parent="1">
